# Original game content, disc images and local research output. Never commit.
# /local is the repository-root local directory. It has no trailing slash because in worktrees it is a symlink to the
# main checkout's directory (git.worktreeSymlinkFolders in .vscode/settings.json, the session.create script in
# .github/github-app.yml), and Git treats a symlink as a file.
/local
*.ccd
*.img
*.sub
*.cue
*.iso
*.mdf
*.mds

# Dependencies and build output
node_modules/
dist/
coverage/
.vite/
playwright-report/
test-results/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Environment and secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
*.log
