{
  // Pure modules: no DOM and no Node types, so browser or Node APIs fail to compile here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsc/core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/core", "src/original-data", "src/content"],
  "exclude": ["**/*.test.ts"]
}
